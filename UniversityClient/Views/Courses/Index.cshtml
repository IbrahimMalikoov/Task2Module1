@model UniversityClient.Models.ClientResponse<IEnumerable<UniversityClient.Models.CourseViewModel>>

@{
    ViewData["Title"] = "Каталог курсов";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h2 mb-0">Каталог университетских курсов</h1>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Обновить</a>
</div>

@if (!Model.Success)
{
    <div class="alert alert-danger shadow-sm" role="alert">
        <h4 class="alert-heading">Ошибка взаимодействия с API</h4>
        <p class="mb-2">@Model.ErrorMessage</p>
        <hr />
        <p class="mb-0 small text-muted">
            Убедитесь, что сервис <strong>UniversityApi</strong> запущен и доступен по адресу, указанному в <code>appsettings.json</code>.
        </p>
    </div>
}
else
{
    <form method="get" asp-action="Index" class="mb-4">
        <div class="input-group">
            <input type="text" name="search" class="form-control" placeholder="Поиск курса по названию..." value="@ViewBag.Search" />
            <button class="btn btn-primary" type="submit">Найти</button>
            @if (!string.IsNullOrWhiteSpace(ViewBag.Search as string))
            {
                <a asp-action="Index" class="btn btn-outline-secondary">Сбросить</a>
            }
        </div>
    </form>

    @if (Model.Data == null || !Model.Data.Any())
    {
        <div class="alert alert-info" role="alert">
            Курсы не найдены.
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 g-4">
            @foreach (var course in Model.Data)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm border-0 bg-light">
                        <div class="card-body d-flex flex-column">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <h5 class="card-title text-primary mb-0">@course.Name</h5>
                                <span class="badge bg-secondary">@course.Credits кредитов</span>
                            </div>
                            <p class="card-text text-muted flex-grow-1">@course.Description</p>
                            <hr />
                            <div class="small text-muted mb-3">
                                <div><strong>Преподаватель:</strong> @(course.Teacher != null ? $"{course.Teacher.FirstName} {course.Teacher.LastName} ({course.Teacher.Department})" : $"ID: {course.TeacherId}")</div>
                                <div><strong>Записано студентов:</strong> @course.EnrolledStudentsCount</div>
                            </div>
                            <div class="mt-auto">
                                <a asp-action="Details" asp-route-id="@course.Id" class="btn btn-outline-primary w-100">Подробнее</a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
}
